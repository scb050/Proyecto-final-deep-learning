   "source": [
    "# Entrenamiento en Colab — Proyecto INMET\n",
    "**IMPORTANTE:** Antes de correr, ve a `Runtime → Change runtime type → T4 GPU`\n\n",
    "Corre las celdas en orden de arriba hacia abajo.\n\n",
    "---\n",
    "⚠️ **Después de cada modelo hay una celda de BACKUP que guarda en Google Drive. No la saltes.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 1 — Clonar repositorio\n",
    "!git clone https://scb050:ghp_YOUR_TOKEN_HERE@github.com/scb050/Proyecto-final-deep-learning.git\n",
    "%cd Proyecto-final-deep-learning\n",
    "!git checkout full-dataset-run\n",
    "!git log --oneline -3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 2 — Instalar dependencias\n",
    "!pip install -e . -q\n",
    "import torch\n",
    "print('GPU disponible:', torch.cuda.is_available())\n",
    "print('Dispositivo:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 3 — Montar Google Drive y descomprimir datos\n",
    "# Primero sube data_processed.tar.gz a la raíz de tu Google Drive\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "!tar -xzf /content/drive/MyDrive/data_processed.tar.gz\n",
    "import os\n",
    "parquets = list(__import__('pathlib').Path('data/processed').glob('*.parquet'))\n",
    "print(f'Parquets encontrados: {len(parquets)} estaciones')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 4 — Verificar configuracion (sampling debe ser false)\n",
    "import yaml\n",
    "with open('config/config.yaml') as f:\n",
    "    cfg = yaml.safe_load(f)\n",
    "print('sampling.enabled:', cfg['sampling']['enabled'])\n",
    "print('seeds_per_model:', cfg['project']['seeds_per_model'])\n",
    "print('epochs:', cfg['training']['epochs'])\n",
    "assert cfg['sampling']['enabled'] == False, 'ERROR: sampling está activado. Haz push del fix primero.'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 5 — Restaurar resultados previos de Drive (si ya corriste modelos antes)\n",
    "# Si es la primera vez, esta celda no hace nada\n",
    "import shutil, os\n",
    "from pathlib import Path\n",
    "drive_backup = Path('/content/drive/MyDrive/experiments_colab')\n",
    "for modelo in ['tcn', 'nbeats', 'transformer', 'tft']:\n",
    "    src = drive_backup / modelo\n",
    "    dst = Path(f'experiments/{modelo}')\n",
    "    if src.exists():\n",
    "        shutil.copytree(str(src), str(dst), dirs_exist_ok=True)\n",
    "        n = len(list(dst.glob('*/seed=*/metrics.json')))\n",
    "        print(f'✅ {modelo} restaurado desde Drive: {n} runs')\n",
    "    else:\n",
    "        print(f'ℹ️  {modelo}: no hay backup previo en Drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELDA 6 — Entrenar TCN\n",
    "!python -m src.training.runner --config config/config.yaml --model tcn"
   ]
  },
