# --- Datos (no se versionan) ---
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Experimentos / artefactos ---
experiments/*
!experiments/.gitkeep
!experiments/persistence/
!experiments/gru/
!experiments/lstm/
!experiments/tcn/
!experiments/nbeats/
!experiments/transformer/
!experiments/tft/
!experiments/informer/
