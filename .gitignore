!experiments/transformer/.gitkeep
experiments/tft/*
!experiments/tft/.gitkeep
experiments/informer/*
!experiments/informer/.gitkeep
mlruns/
mlartifacts/
*.ckpt
*.pt
*.pth
*.h5
*.onnx

# --- Resultados generados ---
results/figures/*
